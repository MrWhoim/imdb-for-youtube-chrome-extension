{
  "manifest_version": 3,
  "name": "TrueRate for YouTube",
  "short_name": "TrueRate",
  "version": "2.3.0",
  "description": "A fairer, IMDb-style rating for YouTube videos — weighs like/dislike confidence, real engagement, and reach vs. the channel's subscriber base.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TrueRate — video rating"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://returnyoutubedislikeapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["rating.js", "pagedata.js", "content.js", "feed.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
